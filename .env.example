# Copiar a .env y completar localmente cuando se implemente cada componente.
# Estos valores son ejemplos. No contienen credenciales reales.
APP_ENV=development
LOG_LEVEL=INFO

# SQL Server / WideWorldImporters (fuente): autenticación integrada de Windows
SQLSERVER_HOST=ANTON\SQLEXPRESS
SQLSERVER_DATABASE=WideWorldImporters
# Vacío: seleccionar automáticamente ODBC Driver 18 o 17 instalado.
SQLSERVER_ODBC_DRIVER=
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_SERVER_CERTIFICATE=no

# Prueba directa PostgreSQL de Supabase (sin URL ni claves API).
# Completar en .env con los parámetros del diálogo Connect del proyecto.
# SSLMODE debe ser require, verify-ca o verify-full; nunca disable/prefer.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=
SUPABASE_DB_NAME=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=
# Supabase PostgreSQL (staging y Data Warehouse)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require
POSTGRES_STAGING_SCHEMA=staging
POSTGRES_DWH_SCHEMA=data_warehouse

# ETL
ETL_BATCH_SIZE=1000

# FastAPI
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# React / Vite. Las variables VITE_ son públicas en el navegador.
# Nunca colocar contraseñas ni claves privadas con este prefijo.
VITE_API_BASE_URL=http://localhost:8000

# Machine Learning
ML_MODEL_DIR=artifacts/models
RANDOM_STATE=42

# IA generativa (proveedor por definir)
GENAI_API_KEY=
GENAI_MODEL=
GENAI_BASE_URL=

# Alertas por correo (configuración opcional futura)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
NOTIFICATION_FROM_EMAIL=
NOTIFICATION_TO_EMAIL=
