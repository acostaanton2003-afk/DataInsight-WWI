# Copiar a .env y completar localmente cuando se implemente cada componente.
# Estos valores son ejemplos. No contienen credenciales reales.
APP_ENV=development
LOG_LEVEL=INFO

# SQL Server / WideWorldImporters (fuente): autenticación integrada de Windows
SQLSERVER_HOST=ANTON\SQLEXPRESS
SQLSERVER_DATABASE=WideWorldImporters
# Vacío: seleccionar automáticamente ODBC Driver 18 o 17 instalado.
SQLSERVER_ODBC_DRIVER=
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_SERVER_CERTIFICATE=no

# Prueba directa PostgreSQL de Supabase (sin URL ni claves API).
# Completar en .env con los parámetros del diálogo Connect del proyecto.
# SSLMODE debe ser require, verify-ca o verify-full; nunca disable/prefer.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=
SUPABASE_DB_NAME=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=
# Supabase PostgreSQL (staging y Data Warehouse)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require
POSTGRES_STAGING_SCHEMA=staging
POSTGRES_DWH_SCHEMA=data_warehouse

# ETL
ETL_BATCH_SIZE=1000

# FastAPI
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Orígenes separados por comas; vacío deshabilita CORS. Sin comodines.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reserva exclusiva del backend para un futuro rol lector; no se conecta todavía.
# No copiar SUPABASE_DB_USER/PASSWORD del ETL ni utilizar postgres.
BACKEND_DB_HOST=
BACKEND_DB_PORT=
BACKEND_DB_NAME=
BACKEND_DB_USER=
BACKEND_DB_PASSWORD=
BACKEND_DB_SSLMODE=

# React / Vite. Las variables VITE_ son públicas en el navegador.
# Nunca colocar contraseñas ni claves privadas con este prefijo.
VITE_API_BASE_URL=http://localhost:8000

# Machine Learning
ML_MODEL_DIR=artifacts/models
RANDOM_STATE=42

# Reserva futura para otros proveedores; GENAI_* no se usa en el asistente Ollama.
GENAI_API_KEY=
GENAI_MODEL=
GENAI_BASE_URL=

# Alertas por correo (configuración opcional futura)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
NOTIFICATION_FROM_EMAIL=
NOTIFICATION_TO_EMAIL=

# BACKEND_DB_USER: wwi_backend_reader (pooler: wwi_backend_reader.<project-ref>).
# Configurar solo en .env local tras autorizar rol y politicas; nunca copiar el administrador ETL.

# Resumen ML local bajo artifacts/machine_learning/. No se busca la última ejecución.
BACKEND_FORECAST_PATH=artifacts/machine_learning/published/resumen.json

# Asistente: local = reglas, gratuito, sin proveedor ni llamadas externas.
ASSISTANT_PROVIDER=local
# Cambiar ASSISTANT_PROVIDER a ollama para Qwen3 local ya instalado; no descarga modelos.
ASSISTANT_OLLAMA_MODEL=qwen3:1.7b
ASSISTANT_OLLAMA_URL=http://127.0.0.1:11434/api/chat
ASSISTANT_LLM_TIMEOUT=30
