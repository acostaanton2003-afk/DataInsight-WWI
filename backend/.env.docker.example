# Solo configuración runtime del backend. Copiar a backend/.env.docker (ignorado).
# No copiar el .env raíz completo: contiene configuración y credenciales del ETL.
# Completar únicamente los BACKEND_DB_* del lector existente, nunca postgres.
SUPABASE_AUTH_URL=https://xunsksfkuabfpvjxhjbk.supabase.co
BACKEND_DB_HOST=
BACKEND_DB_PORT=
BACKEND_DB_NAME=
BACKEND_DB_USER=
BACKEND_DB_PASSWORD=
BACKEND_DB_SSLMODE=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_DOCS_ENABLED=false
BACKEND_FORECAST_PATH=artifacts/machine_learning/published/resumen.json
# No hay Ollama en este contenedor. Conservar reglas locales.
ASSISTANT_PROVIDER=local
